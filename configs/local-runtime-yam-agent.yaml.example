# YAM LLM policies. Client supplies provider credentials per trial.
host: 127.0.0.1
port: 8000
backend:
  name: auto
  options:
    llm:
      robot_type: yam
      # REQUIRED: 12 finite values each, left six joints then right six, radians.
      # Match the Client's calibrated operating limits.
      joint_low: null
      joint_high: null
      joint_max_step: null
      gripper_open_value: 1
      sensors: [head_image, left_image, right_image]
      # REQUIRED: replace with actual joint directions, base mounting and camera geometry.
      robot_notes: ""
      effort: low
      max_llm_calls: 30
      max_speed_frac: 0.1
      log_dir: agent-logs
models:
  # URLs, model identifiers and revisions must match the Router registration.
  # Matches the registered YAM relay deployments; Client keys must be relay keys.
  - name: grok-4.7
    model_type: llm
    url: https://api.yhlxj.ai/v1
    revision: "4.7"
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options:
      robot_type: yam
  - name: claude-opus-5-5
    model_type: llm
    url: https://api.yhlxj.ai
    revision: rig-v1
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options:
      robot_type: yam
      api_auth: bearer
  # Registered by the Router for YAM with the same fields as claude-opus-5-5.
  - name: claude-fable-5-2
    model_type: llm
    url: https://api.yhlxj.ai
    revision: rig-v1
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options:
      robot_type: yam
      api_auth: bearer
  - name: gpt-6-astra
    model_type: llm
    url: https://api.yhlxj.ai/v1
    revision: rig-v1
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 150
    endpoint: inprocess://inspect-agent
    backend_options:
      robot_type: yam
  # Router policyId gemini-4-hydrogen-yam. The Router sends the model name
  # gemini-4-hydrogen: keep it as name (no -yam). The Router registers it with this url,
  # revision '0' and max_horizon 180 (150 for the other LLMs): the runtime matches every
  # descriptor field except control_hz.
  # llm_endpoint: antigravity calls Gemini through the official Antigravity CLI (agy,
  # install: curl -fsSL https://antigravity.google/cli/install.sh | bash) with the
  # Client's Gemini API key (llm_api_keys.google = GEMINI_API_KEY); agy bills that key's
  # AI Studio project. Its model is gemini-4-hydrogen-<effort>. Use llm_endpoint: official
  # to call Google's OpenAI-compatible API directly instead.
  - name: gemini-4-hydrogen
    model_type: llm
    url: https://generativelanguage.googleapis.com/v1beta
    revision: '0'
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 180
    endpoint: inprocess://inspect-agent
    backend_options:
      robot_type: yam
      llm_endpoint: antigravity
      # Hydrogen thinking levels are low, medium, high and xhigh.
      effort: medium
