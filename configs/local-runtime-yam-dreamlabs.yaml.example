host: 127.0.0.1
port: 8000
backend:
  name: dreamlabs
  options:
    # The model on Dream Labs' API. The API key comes from DREAM_API_KEY or ~/.dreamlabs/credentials.
    checkpoint: dreamlabs/dream-1-beta
    # Optional, shown with their defaults:
    # plan_hz: 20           # model rows played per second, as on Dream Labs' YAM stations
    # rows_per_call: 3      # targets returned per inference call
    # warmup_replies: 5     # a session's replies before the dream client's own pacing takes over
    # warmup_gap_s: 1.0     # least time between requests while warming up
    # hold_asks: 3          # extra asks while the first call holds the arms for the task planner; 0 skips the hold
    # hold_period_s: 2.4    # time between those asks
models:
  # The fields below must match the model as registered with the Router.
  - name: dream-1
    model_type: vla
    url: https://huggingface.co/dreamlabs/dream-1
    revision: "0000000000000000000000000000000000000000"
    action_space: joint_position
    action_dim: 14
    control_hz: 30
    max_horizon: 30
    # Unused: the model runs on Dream Labs' API, not a local service.
    endpoint: ws://127.0.0.1:8000
