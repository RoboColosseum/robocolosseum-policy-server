url: wss://router.example.com:8443
token: pol_replace_with_token_from_router_ui
# Must match the policy ID of your deployment on the Router; otherwise evaluation trials are never matched.
policy_id: replace-with-your-policy-id
# Robot contract preset: yam | so101 | franka | earth_rover_mini_plus. Sets action_spaces, control_hz and
# max_horizon; explicit keys below override it.
robot: yam
# max_horizon: 32
# Keep the registration across Router restarts and network drops.
reconnect: true
# WebSocket keepalive in seconds. Raise ping_timeout on slow uplinks.
# ping_interval: 20
# ping_timeout: 60
